// Tarea05_05
// Boletín 1 - Ejercicio 5
//
// Enunciado: Pedir un número e indicar si es positivo o negativo.

Algoritmo Tarea05_05
  Definir num Como Entero
  Escribir "Introduce un número:"
  Leer num
  Si num < 0 Entonces
    Escribir "Negativo"
  Sino
    Si num > 0 Entonces
      Escribir "Positivo"
    Sino
      Escribir "Cero"
    FinSi
  FinSi
FinAlgoritmo
