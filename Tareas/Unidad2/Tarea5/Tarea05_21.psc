// Tarea05_21
// Boletín 1 - Ejercicio 21
//
// Enunciado: Pedir una nota numérica entera entre 0 y 10, y mostrar dicha nota de la forma:
// cero, uno, dos, tres...

Algoritmo Tarea05_21
  Definir nota Como Entero
  Escribir "Introduce una nota entera (0 a 10):"
  Leer nota
  Segun nota Hacer
    0:
      Escribir "cero"
    1:
      Escribir "uno"
    2:
      Escribir "dos"
    3:
      Escribir "tres"
    4:
      Escribir "cuatro"
    5:
      Escribir "cinco"
    6:
      Escribir "seis"
    7:
      Escribir "siete"
    8:
      Escribir "ocho"
    9:
      Escribir "nueve"
    10:
      Escribir "diez"
    De Otro Modo:
      Escribir "Nota fuera de rango"
  FinSegun
FinAlgoritmo
