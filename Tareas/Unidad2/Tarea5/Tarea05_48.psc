// Tarea05_48
// Boletín 3 - Ejercicio 3
//
// Enunciado: Diseña una aplicación que muestre las tablas de multiplicar del 1 al 10.

Algoritmo Tarea05_48
  Definir t,i Como Entero
  Para t <- 1 Hasta 10 Hacer
    Escribir "Tabla del ", t
    Para i <- 1 Hasta 10 Hacer
      Escribir t, " x ", i, " = ", t * i
    FinPara
  FinPara
FinAlgoritmo
