Algoritmo PromedioPonderado
    Definir nota1, nota2, peso1, peso2, promedio Como Real

    peso1 <- 0.4
    peso2 <- 0.6
    Escribir "Ingrese la primera calificación (peso 40%): "
    Leer nota1
    Escribir "Ingrese la segunda calificación (peso 60%): "
    Leer nota2

    promedio <- (nota1 * peso1) + (nota2 * peso2)

    Escribir "El promedio ponderado es: ", promedio
FinAlgoritmo
