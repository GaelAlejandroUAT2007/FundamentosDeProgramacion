Algoritmo NOMINA_SEMANAL
    DEFINIR sueldoPorHora, horasTrabajadas, pagoTotal Como Real;
    ESCRIBIR "Ingrese el sueldo por hora: "; LEER sueldoPorHora;
    ESCRIBIR "Ingrese las horas trabajadas: "; LEER horasTrabajadas;
    pagoTotal <- sueldoPorHora * horasTrabajadas;
    ESCRIBIR "El pago total de la semana es: ";
    ESCRIBIR pagoTotal;
FinAlgoritmo
