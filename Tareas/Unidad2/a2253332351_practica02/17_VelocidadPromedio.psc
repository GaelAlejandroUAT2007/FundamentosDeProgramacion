Algoritmo VELOCIDAD_PROMEDIO
    DEFINIR distancia, tiempo, velocidad Como Real;
    ESCRIBIR "Ingrese la distancia recorrida en km: "; LEER distancia;
    ESCRIBIR "Ingrese el tiempo empleado en horas: "; LEER tiempo;
    velocidad <- distancia / tiempo;
    ESCRIBIR "La velocidad promedio es: ";
    ESCRIBIR velocidad;
FinAlgoritmo
