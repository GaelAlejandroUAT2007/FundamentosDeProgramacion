Algoritmo PROMEDIO_CALIFICACIONES
    DEFINIR nota1, nota2, nota3, promedio Como Real;
    ESCRIBIR "Ingrese la primera calificación: "; LEER nota1;
    ESCRIBIR "Ingrese la segunda calificación: "; LEER nota2;
    ESCRIBIR "Ingrese la tercera calificación: "; LEER nota3;
    promedio <- (nota1 + nota2 + nota3) / 3;
    ESCRIBIR "El promedio es: ";
    ESCRIBIR promedio;
FinAlgoritmo
